APP_NAME=Civin
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://civin-backend-production-emxlmr.laravel.cloud

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Laravel Cloud injects DB_* when a database is attached.
DB_CONNECTION=mysql

# CRITICAL for Filament admin (500 / 419):
# - Use database drivers until a Redis addon is attached and healthy.
# - SESSION_DOMAIN must be null (or the exact host). Never copy admin.example.com.
# - APP_URL must match the public HTTPS host exactly.
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Only switch these to redis AFTER Laravel Cloud Redis is attached and
# /ops/ready returns {"cache":true}.
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=predis
# REDIS_URL=

SANCTUM_STATEFUL_DOMAINS=civin-backend-production-emxlmr.laravel.cloud

# Paste the Firebase service-account JSON (or base64) into the Cloud dashboard.
FIREBASE_CREDENTIALS=
