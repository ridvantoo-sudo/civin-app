APP_NAME=Civin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=civin
DB_USERNAME=civin
DB_PASSWORD=

# Only used when DB_CONNECTION=sqlite. Enables WAL + a busy timeout so
# concurrent requests (e.g. polling admin dashboards) don't hit
# "database is locked", which otherwise surfaces as a 419 page-expired error.
# DB_JOURNAL_MODE=WAL
# DB_BUSY_TIMEOUT=5000
# DB_SYNCHRONOUS=NORMAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SECURE_MEDIA_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_EXPIRATION=60
REFRESH_TOKEN_EXPIRATION_DAYS=30
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Absolute path to a Google service-account JSON file. Never commit that file.
FIREBASE_CREDENTIALS=

# Agora credentials must remain server-side. Token TTL is in duration seconds.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600

# Set these when using a hosted broadcaster such as Reverb or Pusher.
BROADCAST_HOST=
BROADCAST_PORT=443
BROADCAST_SCHEME=https
BROADCAST_APP_ID=
BROADCAST_APP_KEY=
BROADCAST_APP_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_VISIBILITY=public
AWS_THROW=false

# Kubernetes/Prometheus operations endpoints and backup storage.
OPS_METRICS_TOKEN=
OPS_READINESS_TOKEN=
OPS_STORAGE_DISK="${FILESYSTEM_DISK}"
BACKUP_DISK=s3
BACKUP_PREFIX=backups/civin
BACKUP_RETENTION_DAYS=30
BACKUP_AGE_PUBLIC_KEY=
GAME_ANALYTICS_EXPORT_DISK="${FILESYSTEM_DISK}"
CDN_BASE_URL="${AWS_URL}"
CDN_PUBLIC_BASE_URL="${CDN_BASE_URL}"

VITE_APP_NAME="${APP_NAME}"

# Ads self-service (Level X+ or SVIP)
ADS_MIN_CREATOR_LEVEL=10
ADS_ALLOW_SVIP=true
